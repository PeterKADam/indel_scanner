flowchart TD
    subgraph setupPhase[Setup Phase]
        A[Start] --> B[Parse CLI Arguments]
        B --> C[Load config.yaml]
        C --> D[Create run output directory]
        D --> E[Read contig list from BAM header]
    end

    subgraph streamingPhase[Streaming Pipeline]
        E --> F[Initialize ContigScanner]
        F --> G[Create Multiprocessing Pool]
        G --> H[Submit contig tasks]
        H --> I[Process contig streaming scan+filter]
        I --> J[Accumulate passed indels + stats]
        J --> K[Write passed indels TSV]
    end

    subgraph reportingPhase[Reporting]
        K --> L[Write overall mutation frequency]
        L --> M[Write per-type mutation frequency]
        M --> N[End]
    end

flowchart TD
    subgraph setupPhase[Setup Phase]
        A[Parse CLI arguments] --> B[Config.load()]
        B --> C[PipelineConfig: init + output dirs]
        C --> D[Write settings_used.yaml]
        D --> E[Setup logging]
        E --> F[parallel_pipeline()]
    end

    subgraph streamingPhase[Parallel scanning]
        F --> G[Read BAM header contigs]
        G --> H[Pick sampling contig]
        H --> I[Init worker: BAM + FASTA + config]
        I --> J[scan_contig_streaming()]
        J --> K[Parse CIGAR -> candidates]
        K --> L[Apply IndelFilters]
        L --> M[Collect stats + type counts]
        M --> N{in_memory?}
        N -- yes --> O[write_passed_indels()]
        N -- no --> P[Write .part.tsv per contig]
        P --> Q[aggregate_tsv_parts()]
        Q --> R[cleanup_temp_dir()]
    end

    subgraph reportingPhase[Reporting]
        O --> S[write_per_type_mutation_report()]
        R --> S
        S --> T[per_type_mutation_frequency.tsv]
    end

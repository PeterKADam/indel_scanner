graph TD;
    subgraph "Invocation (run.sh)"
        R0[run.sh] --> R1[python -m indel_scanner.main]
        R0 --> R2[Defines BAM/FASTA/STR/output/config paths]
    end

    subgraph "Inputs"
        A[BAM (.bam/.bai)]
        B[Reference FASTA]
        C[config.yaml]
        D[STR results dir]
        E[CLI args]
    end

    subgraph "Core Modules: indel_scanner/"
        F[main.py]
        G[configurator.py]
        H[parallel.py]
        I[scanner.py]
        J[filters.py]
        K[STR_Classifier.py]
        L[homopolymer_classifier.py]
        M[IO.py]
        N[indel.py]
        O[reporting.py]
    end

    subgraph "Key Libraries"
        P[pysam]
        Q[pyfastx]
        R[PyYAML]
        S[multiprocessing.Pool]
        T[rich.progress / rich.live]
        U[polars / pandas]
    end

    subgraph "Outputs"
        V[settings_used.yaml]
        W[passed_indels.tsv]
        X[per_type_mutation_frequency.tsv]
        Y[logs/]
    end

    R1 --> F
    R2 --> E
    E --> G
    C --> G
    G --> F
    G --> V
    F --> H
    H --> I
    I --> J
    I --> K
    J --> L
    I --> N
    I --> M
    H --> M
    F --> O

    A --> P
    B --> Q
    D --> K
    G --> R
    H --> S
    H --> T
    M --> U
    O --> U

    M --> W
    O --> X
    F --> Y

    style R0 fill:#efe,stroke:#333,stroke-width:2px
    style F fill:#ccf,stroke:#333,stroke-width:2px
    style I fill:#f9f,stroke:#333,stroke-width:2px
